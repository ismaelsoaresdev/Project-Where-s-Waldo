generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Target {
  id    String @id @default(uuid())
  name  String
  minX  Float
  maxX  Float
  minY  Float
  maxY  Float
}

model Score {
  id            String   @id @default(uuid())
  playerName    String
  timeInSeconds Int
  createdAt     DateTime @default(now())
}